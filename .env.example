# Server-only. Never prefix with NEXT_PUBLIC_ and never commit the real key.
# Used by app/api/chat/route.ts for the portfolio chatbot (NVIDIA API, https://build.nvidia.com).
NVIDIA_APIKEY=

# Optional: override the chat model (default: google/gemma-4-31b-it).
# Live model ids: https://integrate.api.nvidia.com/v1/models
NVIDIA_MODEL=

# Public production URL of this site (no trailing slash). Drives canonical URLs, sitemap, robots and social previews.
# Optional: defaults to https://www.johnadriancruz.xyz. localhost / non-HTTPS values are ignored.
NEXT_PUBLIC_BASE_URL=https://www.johnadriancruz.xyz
